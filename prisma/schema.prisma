generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====

enum Role {
  BUYER
  FARMER
  COURIER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  CANCELLED
  HARVESTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  HARVESTED
  PICKED_UP
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum DeliveryType {
  ONE_TO_ONE
  POOLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum TxType {
  DELIVERY_FEE
  COMMISSION
  PROMO_CREDIT
  REFUND
  PAYOUT
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LeadType {
  BUSINESS
  FARMER
  OTHER
}

enum Unit {
  KG
  PIECE
  TRAY
  LITER
  BOTTLE
  BUNCH
}

// ===== CORE USER & IDENTITY =====

model User {
  id                 Int                @id @default(autoincrement())
  email              String             @unique
  passwordHash       String
  name               String
  phone              String
  role               Role               @default(BUYER)
  verificationStatus VerificationStatus @default(PENDING)
  farmerId           Int?               @unique
  businessId         Int?               @unique
  courierId          Int?               @unique
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  farmer             Farmer?            @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  business           Business?          @relation(fields: [businessId], references: [id], onDelete: SetNull)
  courier            Courier?           @relation(fields: [courierId], references: [id], onDelete: SetNull)
  notifications      Notification[]
  auditLogs          AuditLog[]         @relation("AuditActor")

  @@index([role])
  @@index([verificationStatus])
}

model Farmer {
  id                 Int                @id @default(autoincrement())
  name               String
  email              String             @unique
  phone              String
  barangay           String             // e.g. "La Paz", "Buenavista", "Antongalon"
  addressText        String             @default("Farm Site, Butuan City")
  idType             String             // "Driver's License", "National ID", "PhilHealth ID"
  idLast4            String             // RA 10173 PII minimization
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByUserId   Int?
  rejectionReason    String?
  reliabilityScore   Float              @default(5.0) // Rolling 1.0 - 5.0
  lat                Float?
  lng                Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User?
  listings           Listing[]
  ratingsReceived    Rating[]           @relation("RatingToFarmer")
  payouts            Payout[]

  @@index([verificationStatus])
}

model Business {
  id                 Int                @id @default(autoincrement())
  name               String
  email              String             @unique
  phone              String
  addressText        String             // Commercial kitchen street address
  barangay           String             // Commercial drop destination barangay
  permitType         String             // "Mayor's Permit", "DTI Registration", "BIR 2303"
  permitLast4        String             // RA 10173 PII minimization
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByUserId   Int?
  rejectionReason    String?
  reliabilityScore   Float              @default(5.0)
  creditTermsDays    Int                @default(0) // 0 = Pay-on-delivery; 7+ = trade credit (coming soon)
  lat                Float?
  lng                Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User?
  orders             Order[]
  ratingsReceived    Rating[]           @relation("RatingToBusiness")

  @@index([verificationStatus])
}

model Courier {
  id                 Int                @id @default(autoincrement())
  name               String
  email              String             @unique
  phone              String
  vehicleType        String             // "motorcycle", "multicab", "tricycle", "van"
  licensePlate       String
  licenseLast4       String             // RA 10173 PII minimization
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByUserId   Int?
  rejectionReason    String?
  reliabilityScore   Float              @default(5.0)
  totalDeliveries    Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User?
  deliveries         Delivery[]
  ratingsReceived    Rating[]           @relation("RatingToCourier")

  @@index([verificationStatus])
}

// ===== MARKETPLACE & LISTINGS =====

model Listing {
  id            Int           @id @default(autoincrement())
  farmerId      Int
  crop          String        // e.g. "Eggplant", "Native Tomatoes", "Squash", "Fresh Milk"
  category      String        @default("Vegetables")
  description   String?
  unit          Unit          @default(KG)
  harvestDate   DateTime      // Forward order harvest date
  estimatedQty  Float         // Total expected kg/unit
  reservedQty   Float         @default(0) // Quantity locked by confirmed orders
  priceCentavos Int           // Price per unit in integer centavos
  minOrderQty   Float         @default(5)
  grade         String?       @default("Grade A")
  imageUrl      String?
  status        ListingStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  farmer        Farmer        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([farmerId])
  @@index([status, harvestDate])
}

// ===== ORDERS & FULFILLMENT =====

model Order {
  id                  Int           @id @default(autoincrement())
  code                String        @unique // e.g. "UMA-2609-0042"
  businessId          Int
  requestedFor        DateTime      // Scheduled delivery date (Manila 8 PM cutoff rule)
  deliveryWindow      String        @default("MORNING_6_9") // MORNING_6_9, MIDDAY_10_1, AFTERNOON_2_5
  deliveryAddress     String
  deliveryType        DeliveryType  @default(ONE_TO_ONE)
  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(UNPAID)
  subtotalCentavos    Int           // Produce subtotal
  deliveryFeeCentavos Int           @default(15000) // ₱150 or ₱100
  discountCentavos    Int           @default(0)     // First-order credit
  totalCentavos       Int           // subtotal + delivery - discount
  notes               String?
  cancelledReason     String?
  idempotencyKey      String?       @unique
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems          OrderItem[]
  delivery            Delivery?
  dispute             Dispute?
  ratings             Rating[]
  payouts             Payout[]
  transactions        Transaction[]

  @@index([businessId, createdAt])
  @@index([status, requestedFor])
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  orderId              Int
  listingId            Int
  qtyRequested         Float    // In kg / units
  priceAtOrderCentavos Int      // Snapshotted price per unit
  lineTotalCentavos    Int      // qtyRequested * priceAtOrderCentavos
  status               String   @default("confirmed") // confirmed, harvested, rerouted, cancelled
  reroutedToListingId  Int?
  createdAt            DateTime @default(now())

  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing              Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@unique([orderId, listingId])
  @@index([orderId])
  @@index([listingId])
}

model Delivery {
  id            Int            @id @default(autoincrement())
  orderId       Int            @unique
  courierId     Int
  routeId       Int?
  pickupTime    DateTime?
  deliveryTime  DateTime?
  pickupProof   String?        // Base64 JPEG data URL <= 250KB
  deliveryProof String?        // Base64 JPEG data URL <= 250KB
  failureReason String?
  status        DeliveryStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier       Courier        @relation(fields: [courierId], references: [id])
  route         Route?         @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@index([courierId])
  @@index([status])
}

model Route {
  id           Int          @id @default(autoincrement())
  date         DateTime
  type         DeliveryType @default(POOLED)
  barangayFrom String       // Origin agricultural hub
  barangayTo   String       // Commercial destination hub
  createdAt    DateTime     @default(now())

  deliveries   Delivery[]
}

// ===== FINANCIALS & LEDGER =====

model Payout {
  id                 Int      @id @default(autoincrement())
  orderId            Int
  farmerId           Int
  grossCentavos      Int      // Produce subtotal for farmer's items
  commissionCentavos Int      // 8% platform commission
  netCentavos        Int      // grossCentavos - commissionCentavos
  status             TxStatus @default(PENDING)
  paidAt             DateTime?
  reference          String?  // Reference code or courier receipt
  createdAt          DateTime @default(now())

  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  farmer             Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@index([orderId])
}

model Transaction {
  id             Int      @id @default(autoincrement())
  orderId        Int
  type           TxType
  amountCentavos Int
  status         TxStatus @default(COMPLETED)
  createdAt      DateTime @default(now())

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ===== TRUST, RATINGS & DISPUTES =====

model Rating {
  id           Int       @id @default(autoincrement())
  orderId      Int
  fromType     String    // "buyer", "farmer", "courier"
  toType       String    // "buyer", "farmer", "courier"
  toFarmerId   Int?
  toBusinessId Int?
  toCourierId  Int?
  score        Float     // 1.0 - 5.0
  comment      String?
  createdAt    DateTime  @default(now())

  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  farmer       Farmer?   @relation("RatingToFarmer", fields: [toFarmerId], references: [id], onDelete: SetNull)
  business     Business? @relation("RatingToBusiness", fields: [toBusinessId], references: [id], onDelete: SetNull)
  courier      Courier?  @relation("RatingToCourier", fields: [toCourierId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([toFarmerId])
  @@index([toBusinessId])
  @@index([toCourierId])
}

model Dispute {
  id             Int           @id @default(autoincrement())
  orderId        Int           @unique
  raisedBy       String        // "business", "farmer"
  description    String
  status         DisputeStatus @default(OPEN)
  resolution     String?
  refundCentavos Int           @default(0)
  evidence       String?       // Base64 photo proof
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ===== LEADS & NOTIFICATIONS =====

model Lead {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  type      LeadType @default(BUSINESS)
  barangay  String?
  message   String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String    // "ORDER_CONFIRMED", "HARVEST_READY", "DELIVERY_UPDATE", "PAYOUT_SENT"
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?
  action      String   // "VERIFY_USER", "TRANSITION_ORDER", "RESOLVE_DISPUTE", "REROUTE_ITEM"
  entity      String   // "Order", "Farmer", "Business", "Dispute"
  entityId    Int?
  meta        Json?
  createdAt   DateTime @default(now())

  actorUser   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}
